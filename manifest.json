{
  "manifest_version": 3,
  "name": "Demeter — API Fault Injector",
  "version": "1.0.0",
  "description": "Toggle fake latency, errors, and malformed responses on specific API endpoints while testing your site.",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "js/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Demeter"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content-interceptor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
